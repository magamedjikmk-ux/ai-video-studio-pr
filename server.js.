
import express from "express";
import cors from "cors";
import OpenAI from "openai";

const app = express();

app.use(cors());
app.use(express.json({ limit: "10mb" }));

const PORT = process.env.PORT || 3000;

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY
});

app.get("/", (req, res) => {
  res.send("AI VIDEO STUDIO PRO is running!");
});

app.get("/api/health", (req, res) => {
  res.json({
    status: "online",
    studio: "AI VIDEO STUDIO PRO"
  });
});

// AI VIDEO DIRECTOR
app.post("/api/director", async (req, res) => {
  try {
    const { prompt, style, duration } = req.body;

    if (!prompt || typeof prompt !== "string") {
      return res.status(400).json({
        error: "Please provide a video idea."
      });
    }

    if (prompt.length > 8000) {
      return res.status(400).json({
        error: "Prompt is too long."
      });
    }

    const response = await openai.responses.create({
      model: "gpt-5.5",
      instructions: `
You are AI VIDEO DIRECTOR PRO.

You are an expert video editor and creative director.

Create professional video editing plans.
Include:
1. Scene-by-scene storyboard.
2. Camera movements.
3. Visual effects.
4. Transitions.
5. Music and sound suggestions.
6. Voiceover in Russian.
7. AI image and video prompts.
8. Timeline with timestamps.

Return clear structured instructions in Russian.
Do not claim that a video has been rendered.
`,
      input: `
Video idea: ${prompt}
Style: ${style || "Cinematic"}
Duration: ${duration || "30 seconds"}

Create a professional editing plan.
`
    });

    res.json({
      success: true,
      director: "AI VIDEO DIRECTOR PRO",
      result: response.output_text
    });

  } catch (error) {
    console.error("AI Error:", error.message);

    res.status(500).json({
      error: "AI processing failed. Check API configuration."
    });
  }
});

app.listen(PORT, "0.0.0.0", () => {
  console.log("AI VIDEO STUDIO PRO started on port " + PORT);
});
